{
  "schemaVersion": 2,
  "id": "com.t3code.bizpulse",
  "displayName": "BizPulse portfolio operations",
  "version": "0.5.0",
  "description": "Startup portfolio health, growth bottlenecks, CRM follow-ups and BizPulse agent actions.",
  "mcpServer": {
    "name": "bizpulse",
    "transport": {
      "type": "http",
      "url": "https://bizpulse.cc/mcp/portfolio",
      "headers": [],
      "auth": {
        "type": "oauth",
        "scopes": [
          "portfolio:read",
          "crm:read",
          "actions:read",
          "actions:approve"
        ]
      }
    }
  },
  "contributes": {
    "panels": [
      {
        "id": "bizpulse-portfolio",
        "title": "Portfolio pulse",
        "scope": "project",
        "resourceUri": "ui://bizpulse/portfolio.html",
        "tool": {
          "name": "bizpulse_portfolio"
        }
      },
      {
        "id": "bizpulse-crm",
        "title": "CRM follow-ups",
        "scope": "thread",
        "resourceUri": "ui://bizpulse/crm.html"
      }
    ],
    "commands": [
      {
        "id": "bizpulse-open-portfolio",
        "title": "BizPulse: Open portfolio pulse",
        "panel": "bizpulse-portfolio"
      },
      {
        "id": "bizpulse-open-crm",
        "title": "BizPulse: Open CRM follow-ups",
        "panel": "bizpulse-crm"
      }
    ]
  },
  "t3Tools": []
}
